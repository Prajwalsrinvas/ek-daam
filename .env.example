# Copy to .env and fill in. .env is gitignored - never commit a real key.
# Every value below is a DUMMY placeholder.

# --- Bright Data ---------------------------------------------------------
# API key from https://brightdata.com/cp/setting/users  (Bearer token)
BD_API_KEY=bd_dummy_key_replace_me
# mock = no network, runs off tests/fixtures. live = real Scraper Studio calls.
BD_MODE=mock
BD_BASE_URL=https://api.brightdata.com

# --- Collectors ----------------------------------------------------------
# Scraper Studio collector ids (they start with c_). Empty = universe shows as
# "not wired" in /api/universes and refuses dispatch in live mode.
SVERSE_COLLECTOR_ZEPTO=
SVERSE_COLLECTOR_BLINKIT=
SVERSE_COLLECTOR_INSTAMART=
# The chaos universe reads the store this app serves at /chaos. Leave empty and
# it reports "not wired" and takes no part in a run.
SVERSE_COLLECTOR_CHAOS=
# dev = trigger the development version of the collector; prod = published.
# prod is the DEFAULT, and choosing dev has to be deliberate: a collector's
# delivered fields are synced from the template's output schema only on a save to
# production, so a dev-version run can deliver a truncated projection of rows the
# template really did collect - which reaches the app as a shape mismatch and
# reports zero_rows{broken}, i.e. "the store had nothing".
SVERSE_COLLECTOR_VERSION=prod
# Per-universe override: SVERSE_COLLECTOR_VERSION_<UNIVERSE>. Runs the dev
# template for ONE universe while the rest of the demo stays on the published
# ones - which is how a new or edited collector gets a real run before it is
# promoted, without dropping every other universe back to a draft template.
# Only dev/prod are accepted; anything else (or empty) falls back to the global
# setting rather than being sent to /dca/trigger. The effective value is what
# /api/universes reports for that universe and what its `universe_dispatched`
# and `triggered` events carry.
SVERSE_COLLECTOR_VERSION_ZEPTO=
SVERSE_COLLECTOR_VERSION_BLINKIT=
SVERSE_COLLECTOR_VERSION_INSTAMART=
SVERSE_COLLECTOR_VERSION_CHAOS=

# --- Guards --------------------------------------------------------------
# There is no pincode table and no coordinate map. The app accepts any 6-digit
# Indian pincode (^[1-9][0-9]{5}$) and any query of 2-60 printable characters,
# and sends the collector {keyword, pincode} - no lat/long, which no collector
# ever read: each one types the pincode into the site's own location picker.
#
# Comma separated. Empty = any query allowed. Demo mode may set a short list.
SVERSE_QUERY_ALLOWLIST=
# Clamped on load: below 1 nothing could ever run, so a value under it is
# corrected to the default and the correction is logged.
SVERSE_MAX_CONCURRENT_RUNS=1
SVERSE_RATE_LIMIT_PER_MIN=5
# Seconds one client IP must wait between runs (429 while it waits). This is the
# brake that makes open inputs safe to expose; 0 turns it off.
SVERSE_RUN_COOLDOWN_S=60
# LIVE runs allowed per UTC day across every client, the brake on the collector
# budget that the per-client cooldown cannot be. Replays and self-heals call no
# collector and are not counted. Clamped to >= 1; held in memory, so a restart
# starts the day's count over. Once it is spent, POST /api/runs answers 429.
SVERSE_DAILY_RUN_BUDGET=300

# ADVISORY store map, PER UNIVERSE: SVERSE_<UNIVERSE>_STORE_MAP. A store id only
# means something to the site that issued it, so each universe has its own.
#   pincode:store-id                 - semicolon separated for several pincodes
#   pincode:store-id|store-id        - `|` allows SEVERAL stores for one pincode
# NOTHING IS EVER REFUSED ON THIS MAP. Location is proved by what the site
# resolved (see README "Location proof"); this only decides the `known_store`
# flag on the `validated` event: true = every reported store is one you listed,
# false = one is new to you, absent map = reported as unknown.
# Not a secret - any logged-out browser sees it - but kept out of the repo per
# DESIGN.md §10.
# List every store observed for the pincode, separated by `|`.
SVERSE_ZEPTO_STORE_MAP=
# Blinkit reports a numeric merchant_id, and one response legitimately mixes the
# express dark store with a longtail warehouse. List every observed id.
SVERSE_BLINKIT_STORE_MAP=
# Instamart reports a numeric `podId` - same idea as Blinkit's merchant id.
SVERSE_INSTAMART_STORE_MAP=

# --- Timing --------------------------------------------------------------
# Both are clamped on load (>= 0.5s and >= 1s). Zero would mean a busy loop
# against /dca/log and a universe that times out before it starts.
SVERSE_POLL_INTERVAL_S=2.5
SVERSE_UNIVERSE_TIMEOUT_S=240
# Seconds a collector job may report zero navigations and zero lines before it
# is treated as one Bright Data accepted but never allocated a worker to. That
# job is canceled and ONE replacement is triggered for the same universe; the
# universe timeout above keeps running across the swap, so a retrigger is a
# second chance inside the same deadline, not a second deadline. Clamped to
# >= 15s: a healthy job here has delivered rows in about 36s.
SVERSE_STALL_RETRIGGER_S=75
# Per-step delay of the mock driver, seconds. 0 makes mock runs instant (tests).
SVERSE_MOCK_STEP_DELAY_S=0.4
# Replay pacing: real inter-event gaps are used, capped at this many seconds.
SVERSE_REPLAY_MAX_GAP_S=2.0

# --- The chaos store -----------------------------------------------------
# The app serves its own small grocery store at /chaos, in two structurally
# different renderings of the same catalogue. Which one is served is server-side
# state: this is the startup value, and it is changed at runtime only through
# POST /api/chaos/flip.
SVERSE_CHAOS_VERSION=v1
# Shared secret for the chaos admin endpoints (POST /api/chaos/flip and
# POST /api/chaos/heal), sent as the X-Chaos-Token header. EMPTY MEANS DISABLED:
# with no token set there is no value a caller could send that would be
# accepted, so both endpoints answer 503. Not a login and not a user account:
# one operator secret for two demo controls.
SVERSE_CHAOS_ADMIN_TOKEN=

# --- Self-healing --------------------------------------------------------
# POST /api/chaos/heal drives Bright Data's AI flow: refactor_template, then
# resume_automation_job with auto_save once the job reaches its approval gate.
# Both are clamped on load (>= 1s and >= 10s). Measured heals in this project
# ran from ~30s to ~4.5 minutes, so the timeout is deliberately generous.
SVERSE_HEAL_POLL_INTERVAL_S=5
SVERSE_HEAL_TIMEOUT_S=600

# --- Anonymous run ownership ---------------------------------------------
# NOT AUTHENTICATION. Every visitor is handed one opaque random cookie
# (`ekdaam_owner`) and a run stores only its SHA-256, so a public demo does not
# show one visitor's searches to the next one. There is no account behind it:
# clearing cookies makes a new identity and the old runs become unreachable.
# See server/owner.py.
#
# THE ONE PUBLIC RUN. A run id named here is readable and replayable by anyone,
# whoever captured it - the judges' one-click demo. Empty = no public run, and
# the UI offers no demo button. Point it at a curated capture under
# runs/replays/ on the deployment; runs/ is gitignored in full, so the capture is
# not tracked and a fresh clone has none.
SVERSE_DEMO_RUN_ID=
# Whether the owner cookie is marked Secure. Unset = decide per request from the
# request scheme and X-Forwarded-Proto, which is what a deployment behind Caddy
# needs (Caddy terminates TLS, so the app's own scheme is http). Set to 1 or 0
# only for a proxy that sets neither. Marking it Secure on plain http means the
# browser never sends it back and every request looks like a new visitor.
SVERSE_COOKIE_SECURE=

# --- Storage -------------------------------------------------------------
SVERSE_RUNS_DIR=runs
# Dev-only. Where BD_MODE=mock reads <universe>_collector_result.json from.
# Point it elsewhere to preview a different payload shape without spending credits.
SVERSE_FIXTURES_DIR=tests/fixtures
